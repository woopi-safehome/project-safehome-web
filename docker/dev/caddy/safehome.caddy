# safehome.devupii.store — 웹 프론트와 API 를 **같은 출처**로 묶는다.
#
# 같은 출처여야 하는 이유: 비회원 분석의 주인을 가리는 쿠키가 `Secure` + `path=/api` 로 내려온다.
# 웹과 API 가 다른 호스트에 있으면 그 쿠키가 실리지 않아, 업로드한 사람이 자기 결과를 보지 못한다.
#
# **이 파일이 원본이고 서버의 `/etc/caddy/sites/safehome.caddy` 가 사본이다.**
# 고칠 때 이 파일을 고치고 서버로 옮긴다. 서버에서만 고치면 다음 재구축 때 사라진다.
#
# 서버의 Caddy 는 다른 프로젝트와 함께 쓰는 공용이다. 공용 `/etc/caddy/Caddyfile` 은
# 전역 설정과 `import /etc/caddy/sites/*.caddy` 만 갖고, 여기서는 이 사이트 블록 하나만 맡는다.
# 공용 파일은 고치지 않는다 — 한 프로젝트가 고치면 다른 프로젝트의 입구가 함께 바뀐다.
#
# 인증서는 Caddy 가 이 주소로 알아서 받고 갱신한다. TLS 설정을 적지 않는다.
#
# 전달 헤더: Host · X-Forwarded-For · X-Forwarded-Proto 는 Caddy 가 기본으로 보낸다.
# nginx 때 보내던 X-Real-IP 는 보내지 않는다 — API 도 웹도 읽지 않는다 (API 는 X-Forwarded-For 만 본다).
# X-Forwarded-For 는 공용 설정에 trusted_proxies 가 없으면 클라이언트가 보낸 값을 버리고
# 실제 연결 주소로 새로 쓴다. API 가 이 헤더의 맨 앞을 요청자로 믿으므로 그쪽이 맞다.

safehome.devupii.store {
	# 업로드 한도. 애플리케이션의 한도보다 넉넉히 두어 **한도를 판단하는 곳을 애플리케이션 한 곳으로 모은다.**
	# 앞단이 먼저 자르면 사용자는 API 가 만든 에러 응답 대신 Caddy 의 빈 413 을 보고,
	# 한도가 두 곳에 있으면 하나만 바꾼 날 어긋난다. 그렇다고 없애지는 않는다 — 기본값은 무제한이다.
	# 단위는 MiB 다. Caddy 의 MB 는 10진(1000²)이라 nginx 때의 20m 보다 작아진다.
	request_body {
		max_size 20MiB
	}

	# API. handle 은 경로를 그대로 넘긴다. handle_path 나 uri strip_prefix 로 바꾸면
	# `/api` 가 잘려 나가 전부 404 가 된다.
	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			# 진행 상황 스트림(SSE). 둘 중 하나라도 빠지면 단계 표시가 동작하지 않는다.
			#   flush_interval -1 — 모았다가 내보내지 않고 받는 즉시 흘려보낸다
			#   read_timeout      — 분석 서버가 버티는 300초보다 길어야 한다
			flush_interval -1
			transport http {
				read_timeout 310s
			}
		}
	}

	# 웹 프론트.
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
